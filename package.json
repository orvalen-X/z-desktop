{
  "name": "z-desktop",
  "productName": "Z",
  "version": "0.4.4",
  "zReleaseName": "DNA",
  "description": "Z by Orvalen for desktop: the whole screen becomes Z.",
  "homepage": "https://orvalen-official.com",
  "author": "Orvalen",
  "private": true,
  "main": "src/main.js",
  "desktopName": "z-desktop.desktop",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:setup": "node scripts/build-setup.mjs",
    "dist:win": "electron-builder --win nsis-web --x64 --arm64 --publish never && electron-builder --win nsis --x64 --publish never -c.directories.output=dist-full && node scripts/collect-windows.mjs",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "me.orvalen.z",
    "productName": "Z",
    "copyright": "Copyright © Orvalen",
    "artifactName": "Z-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Z-Setup-${version}.${ext}",
      "shortcutName": "Z",
      "uninstallDisplayName": "Z"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Z uses the camera for video calls.",
        "NSMicrophoneUsageDescription": "Z uses the microphone for calls and voice messages.",
        "NSLocationWhenInUseUsageDescription": "Z uses your location when you share it or use the map."
      }
    },
    "dmg": {
      "artifactName": "Z-${version}-mac-universal.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "synopsis": "Z by Orvalen for desktop",
      "maintainer": "Orvalen <noreply@orvalen-official.com>",
      "executableName": "z-desktop",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Actions": "ResetPermissions;CheckUpdates;"
        },
        "desktopActions": {
          "ResetPermissions": {
            "Name": "Reset permissions",
            "Exec": "z-desktop --reset-permissions"
          },
          "CheckUpdates": {
            "Name": "Check for updates",
            "Exec": "z-desktop --check-updates"
          }
        }
      }
    },
    "deb": {
      "artifactName": "z-desktop_${version}_${arch}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "orvalen-X",
        "repo": "z-desktop",
        "releaseType": "draft"
      }
    ],
    "nsisWeb": {
      "artifactName": "Z-Web-Setup-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
